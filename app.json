{
  "expo": {
    "name": "SDMS",
    "slug": "ktx-dn",
    "scheme": "ktxdn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartdormitory.student"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7DB3F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép SDMS chọn ảnh đại diện, gửi tin nhắn và minh chứng yêu cầu.",
          "cameraPermission": "Cho phép SDMS chụp ảnh đại diện, gửi tin nhắn và minh chứng yêu cầu."
        }
      ],
      "expo-font",
      "expo-sharing"
    ]
  }
}
