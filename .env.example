# Cùng API backend với ứng dụng web (VITE_API_URL).
EXPO_PUBLIC_API_URL=https://sdms-server.duckdns.org/api/sdms/v1

# true = đăng nhập giả lập để xem UI mock (không gọi backend)
EXPO_PUBLIC_MOCK_AUTH=false

# Header Origin khi mở WebSocket (thông báo, cảnh báo IoT, số đo giờ mới realtime).
# Backend chỉ nhận origin có trong CORS_ALLOWED_ORIGINS: đặt bằng domain web đã được cho phép,
# hoặc để trống và thêm origin của API (vd. https://sdms-server.duckdns.org) vào CORS_ALLOWED_ORIGINS.
EXPO_PUBLIC_WS_ORIGIN=
